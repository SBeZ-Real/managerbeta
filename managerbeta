local function SetupProtectionAndReconnect(accData)
    if Config.AntiAFK ~= false then
        LocalPlayer.Idled:Connect(function()
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new())
            end)
        end)
    end

    if Config.AutoReconnect ~= false then
        GuiService.ErrorMessageChanged:Connect(function()
            if OrderFinished then
                return
            end
            task.wait(3)
            if not OrderFinished then
                accData.LastSeen = os.time()
                SaveAccountData(LocalPlayer.Name, accData)
                RegisterAutoExecute()
                pcall(function()
                    TeleportService:Teleport(game.PlaceId, LocalPlayer)
                end)
            end
        end)
    end

    if Config.HopOnFriendJoin ~= false then
        local function CheckPlayerFriend(plr)
            if plr ~= LocalPlayer then
                local ok, isFriend = pcall(function()
                    return LocalPlayer:IsFriendsWith(plr.UserId)
                end)
                if ok and isFriend then
                    HopLowestPingServer(accData, "Có bạn bè (" .. plr.Name .. ") vào server")
                end
            end
        end

        for _, plr in ipairs(Players:GetPlayers()) do
            task.spawn(CheckPlayerFriend, plr)
        end

        Players.PlayerAdded:Connect(function(plr)
            CheckPlayerFriend(plr)
        end)
    end
end

local function StartActiveOrderLoop(accData)
    RegisterAutoExecute()
    SetupProtectionAndReconnect(accData)
    local hudLabel = CreateStatusOverlay()

    local hopIntervalSeconds = ParseTimeString(Config.HopInterval or "1h")
    local summaryIntervalSeconds = ParseTimeString(Config.SummaryUpdateInterval or "3m")
    local sessionElapsed = 0
    local lastSaveElapsed = 0
    local lastSummaryElapsed = 0

    task.spawn(function()
        UpdateSummaryWebhook()
    end)

    while task.wait(1) do
        if OrderFinished then
            break
        end

        accData.RemainingSeconds = math.max(0, (accData.RemainingSeconds or 0) - 1)
        accData.LastSeen = os.time()
        sessionElapsed = sessionElapsed + 1
        lastSaveElapsed = lastSaveElapsed + 1
        lastSummaryElapsed = lastSummaryElapsed + 1

        if hudLabel and hudLabel.Parent then
            hudLabel.Text = string.format("  Acc: %s | Đơn: %s\n  Còn lại: %s | Ping: %d ms", LocalPlayer.Name, tostring(accData.OrderName), FormatSeconds(accData.RemainingSeconds), GetCurrentPing())
        end

        if accData.RemainingSeconds <= 0 then
            OrderFinished = true
            accData.Status = "Done"
            accData.RemainingSeconds = 0
            accData.LastSeen = os.time()
            SaveAccountData(LocalPlayer.Name, accData)
            SendDoneWebhook(accData)
            UpdateSummaryWebhook()
            pcall(function()
                LocalPlayer:Kick("Đã hoàn thành đơn: " .. tostring(accData.OrderName))
            end)
            task.wait(2)
            pcall(function()
                game:Shutdown()
            end)
            break
        end

        if lastSaveElapsed >= 10 then
            lastSaveElapsed = 0
            SaveAccountData(LocalPlayer.Name, accData)
        end

        if lastSummaryElapsed >= summaryIntervalSeconds then
            lastSummaryElapsed = 0
            task.spawn(function()
                SaveAccountData(LocalPlayer.Name, accData)
                UpdateSummaryWebhook()
            end)
        end

        if Config.AutoHopByTime ~= false and sessionElapsed >= hopIntervalSeconds then
            sessionElapsed = 0
            HopLowestPingServer(accData, "Hop định kỳ theo thời gian (" .. tostring(Config.HopInterval) .. ")")
        end
    end
end

local function InitializeManager()
    local existingAcc = GetAccountData(LocalPlayer.Name)

    if existingAcc and existingAcc.Status == "Active" and (existingAcc.RemainingSeconds or 0) > 0 then
        StartActiveOrderLoop(existingAcc)
    elseif existingAcc and (existingAcc.Status == "Done" or (existingAcc.RemainingSeconds or 0) <= 0) then
        CreateRegrindPromptUI(existingAcc.OrderName, function()
            CreateOrderInputUI(function(orderName, totalSeconds)
                local newAcc = {
                    Username = LocalPlayer.Name,
                    OrderName = orderName,
                    InitialSeconds = totalSeconds,
                    RemainingSeconds = totalSeconds,
                    Status = "Active",
                    LastSeen = os.time()
                }
                SaveAccountData(LocalPlayer.Name, newAcc)
                StartActiveOrderLoop(newAcc)
            end)
        end, function()
            pcall(function()
                game:Shutdown()
            end)
        end)
    else
        CreateOrderInputUI(function(orderName, totalSeconds)
            local newAcc = {
                Username = LocalPlayer.Name,
                OrderName = orderName,
                InitialSeconds = totalSeconds,
                RemainingSeconds = totalSeconds,
                Status = "Active",
                LastSeen = os.time()
            }
            SaveAccountData(LocalPlayer.Name, newAcc)
            StartActiveOrderLoop(newAcc)
        end)
    end
end

InitializeManager()
