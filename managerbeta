local function ParseTimeString(str)
    if type(str) == "number" then
        return str
    end
    if type(str) ~= "string" then
        return 3600
    end
    local total = 0
    local lower = string.lower(str)
    for val, unit in string.gmatch(lower, "(%d+)%s*([a-zA-ZÀ-ỹ]+)") do
        local num = tonumber(val) or 0
        if string.find(unit, "^d") or string.find(unit, "^ng") then
            total = total + (num * 86400)
        elseif string.find(unit, "^h") or string.find(unit, "^g") then
            total = total + (num * 3600)
        elseif string.find(unit, "^m") or string.find(unit, "^p") then
            total = total + (num * 60)
        elseif string.find(unit, "^s") then
            total = total + num
        end
    end
    if total == 0 then
        local rawNum = tonumber(str)
        if rawNum then
            total = rawNum * 60
        else
            total = 3600
        end
    end
    return total
end

local function FormatSeconds(seconds)
    seconds = math.max(0, math.floor(seconds or 0))
    local d = math.floor(seconds / 86400)
    local h = math.floor((seconds % 86400) / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = seconds % 60
    if d > 0 then
        return string.format("%d ngày %02d giờ %02d phút", d, h, m)
    elseif h > 0 then
        return string.format("%02d giờ %02d phút %02d giây", h, m, s)
    else
        return string.format("%02d phút %02d giây", m, s)
    end
end

