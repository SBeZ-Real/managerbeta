local function UpdateSummaryWebhook()
    if not HttpRequest then
        return
    end
    local oldMsgId = GetLastSummaryMessageId()
    if oldMsgId and oldMsgId ~= "" then
        pcall(function()
            HttpRequest({
                Url = WebhookSummary .. "/messages/" .. tostring(oldMsgId),
                Method = "DELETE"
            })
        end)
    end

    local allAccounts = FetchAllAccounts()
    local now = os.time()
    local lines = {}
    local activeCount = 0

    for username, info in pairs(allAccounts) do
        if type(info) == "table" and info.Status == "Active" and (info.RemainingSeconds or 0) > 0 then
            activeCount = activeCount + 1
            local isOnline = (now - (info.LastSeen or 0)) <= 90
            local statusText = isOnline and "🟢 Online" or "🔴 Offline"
            local remainText = FormatSeconds(info.RemainingSeconds)
            local orderText = info.OrderName or "Không tên"
            table.insert(lines, string.format("**%s** | %s\n└ Đơn: `%s` | Còn lại: `%s`", username, statusText, orderText, remainText))
        end
    end

    local descriptionText = activeCount > 0 and table.concat(lines, "\n\n") or "Hiện không có tài khoản nào đang treo đơn."

    local payload = {
        embeds = {{
            title = "BẢNG TỔNG HỢP TÀI KHOẢN ĐANG CHẠY",
            description = descriptionText,
            color = 3447003,
            footer = {
                text = "Tổng số acc đang cày: " .. tostring(activeCount) .. " | Cập nhật lúc " .. os.date("%H:%M:%S %d/%m/%Y")
            }
        }}
    }

    local ok, res = pcall(function()
        return HttpRequest({
            Url = WebhookSummary .. "?wait=true",
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(payload)
        })
    end)

    if ok and res and (res.StatusCode == 200 or res.StatusCode == 201) and res.Body then
        local decOk, bodyData = pcall(function()
            return HttpService:JSONDecode(res.Body)
        end)
        if decOk and bodyData and bodyData.id then
            SetLastSummaryMessageId(tostring(bodyData.id))
        end
    end
end

