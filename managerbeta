end

local function HopLowestPingServer(accData, reason)
    if IsHopping or OrderFinished then
        return
    end
    IsHopping = true
    accData.LastSeen = os.time()
    SaveAccountData(LocalPlayer.Name, accData)
    SaveVisitedServer(game.JobId)

    local visited = GetVisitedServers()
    local bestServer = nil
    local lowestPing = math.huge
    local cursor = ""

    for _ = 1, 3 do
        local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s", game.PlaceId, cursor ~= "" and ("&cursor=" .. cursor) or "")
        local ok, res = pcall(function()
            return game:HttpGet(url)
        end)
        if ok and res then
            local decOk, data = pcall(function()
                return HttpService:JSONDecode(res)
            end)
            if decOk and data and type(data.data) == "table" then
                for _, srv in ipairs(data.data) do
                    local playing = tonumber(srv.playing) or 0
                    local maxPlayers = tonumber(srv.maxPlayers) or 0
                    local ping = tonumber(srv.ping) or 9999
                    if srv.id ~= game.JobId and not visited[srv.id] and playing < (maxPlayers - 1) and ping > 0 then
                        if ping < lowestPing then
                            lowestPing = ping
                            bestServer = srv.id
                        end
                    end
                end
                if bestServer then
                    break
                end
                if data.nextPageCursor then
                    cursor = data.nextPageCursor
                else
                    break
                end
            else
                break
            end
        else
            break
        end
    end

    SendHopWebhook(accData, reason, lowestPing < math.huge and lowestPing or GetCurrentPing())
    RegisterAutoExecute()

    if bestServer then
        SaveVisitedServer(bestServer)
        local ok = pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, bestServer, LocalPlayer)
        end)
        if not ok then
            task.wait(2)
            IsHopping = false
            pcall(function()
                TeleportService:Teleport(game.PlaceId, LocalPlayer)
            end)
        end
    else
        pcall(function()
            TeleportService:Teleport(game.PlaceId, LocalPlayer)
        end)
    end
    task.delay(15, function()
        IsHopping = false
    end)
end

