local function ReadLocalStore()
    if isfile and isfile(StateFileName) then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(readfile(StateFileName))
        end)
        if ok and type(data) == "table" then
            return data
        end
    end
    return { Accounts = {}, LastSummaryMessageId = nil }
end

local function WriteLocalStore(store)
    if writefile then
        pcall(function()
            writefile(StateFileName, HttpService:JSONEncode(store))
        end)
    end
end

local function CleanDbUrl()
    local url = Config.DatabaseUrl or ""
    url = string.gsub(url, "/+$", "")
    return url
end

local function GetAccountData(username)
    local store = ReadLocalStore()
    local localAcc = store.Accounts and store.Accounts[username]
    local dbUrl = CleanDbUrl()
    if dbUrl ~= "" and HttpRequest then
        local ok, res = pcall(function()
            return HttpRequest({
                Url = dbUrl .. "/accounts/" .. username .. ".json",
                Method = "GET"
            })
        end)
        if ok and res and res.StatusCode == 200 and res.Body and res.Body ~= "null" then
            local decOk, remoteAcc = pcall(function()
                return HttpService:JSONDecode(res.Body)
            end)
            if decOk and type(remoteAcc) == "table" then
                store.Accounts[username] = remoteAcc
                WriteLocalStore(store)
                return remoteAcc
            end
        end
    end
    return localAcc
end

local function SaveAccountData(username, accData)
    local store = ReadLocalStore()
    store.Accounts = store.Accounts or {}
    store.Accounts[username] = accData
    WriteLocalStore(store)
    local dbUrl = CleanDbUrl()
    if dbUrl ~= "" and HttpRequest then
        pcall(function()
            HttpRequest({
                Url = dbUrl .. "/accounts/" .. username .. ".json",
                Method = "PUT",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode(accData)
            })
        end)
    end
end

